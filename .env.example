# =============================================
# AI-Powered Document & Image Verification Platform
# Environment Variables — Example
# Copy this file to .env and fill in real values
# NEVER commit .env to Git
# =============================================

# ----- PostgreSQL / Neon -----
DATABASE_URL=your_postgresql_connection_url_here
# Example: postgresql://user:password@host/dbname?sslmode=require

# ----- App Settings -----
APP_NAME=AI Document Image Verification Platform
APP_HOST=127.0.0.1
APP_PORT=8002
UPLOAD_FOLDER=uploads
MAX_FILE_SIZE=10485760

# ----- Cloudinary (for document cloud storage) -----
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ----- Frontend (Next.js) -----
# Set this in frontend/.env.local
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
